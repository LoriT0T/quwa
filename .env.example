# ── Deployment ───────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://lorit0t.github.io
PUBLIC_BASE_PATH=/quwa

# ── Commerce mode ────────────────────────────────────────────────────────────
# mock            no network; full flow simulated in-browser (default, safe)
# hosted          checkout links go straight to the provider's hosted checkout,
#                 provider handles delivery. No Worker required.
# worker          checkout via provider + Cloudflare Worker for signed downloads,
#                 subscription gating and magic-link login.
PUBLIC_COMMERCE_MODE=mock

# ── Payment provider (used when PUBLIC_COMMERCE_MODE != mock) ────────────────
# lemonsqueezy | paddle | stripe
PUBLIC_PAYMENT_PROVIDER=lemonsqueezy
PUBLIC_LEMONSQUEEZY_STORE=
PUBLIC_PADDLE_CLIENT_TOKEN=
PUBLIC_PADDLE_ENV=sandbox
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Worker (server-side only; never referenced from src/) ────────────────────
WORKER_BASE_URL=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DOWNLOAD_SIGNING_SECRET=
MAGIC_LINK_SECRET=

# ── Email provider ───────────────────────────────────────────────────────────
# mock | mailerlite | convertkit | resend
PUBLIC_EMAIL_PROVIDER=mock
PUBLIC_EMAIL_FORM_ENDPOINT=
EMAIL_API_KEY=

# ── Portfolio sample mode ────────────────────────────────────────────────────
# true  (default) noindex sitewide, robots disallow all, persistent notice on
#       every page, checkout presents no payment form and cannot take money.
# false only when this becomes a real store.
PUBLIC_SAMPLE_MODE=true
