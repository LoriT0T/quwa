---
import { getDict, type Locale } from '../i18n';
import { SAMPLE_MODE } from '../config/site';
/** This build is a portfolio sample. Nothing about it should be mistakable for a
    live store — so the notice is persistent, on every page, above the fold, and
    not dismissible. */
interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = getDict(lang);
---
{SAMPLE_MODE && (
  <div class="sample" role="note">
    <div class="container-page inner">
      <span class="tag">{t.sample.badge}</span>
      <p class="msg">{t.sample.banner}</p>
    </div>
  </div>
)}
<style>
  .sample {
    background: repeating-linear-gradient(
      45deg, var(--c-surface-2), var(--c-surface-2) 12px,
      var(--c-surface) 12px, var(--c-surface) 24px
    );
    border-block-end: 1px solid var(--c-line-strong);
  }
  .inner {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
  }
  .tag {
    flex: none; padding: 4px 10px; border-radius: var(--r-sm);
    background: var(--c-accent); color: var(--c-accent-ink);
    font-size: var(--fs-eyebrow); font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-eyebrow); text-transform: uppercase;
  }
  :global(:root[lang="ar"]) .tag { text-transform: none; }
  .msg { font-size: var(--fs-small); color: var(--c-paper); line-height: 1.5; }
</style>
