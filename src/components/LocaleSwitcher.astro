---
import { getDict, LOCALES, type Locale } from '../i18n';
import { localePath } from '../lib/url';
interface Props { lang: Locale; path: string; }
const { lang, path } = Astro.props;
const t = getDict(lang);
const other = LOCALES.find((l) => l !== lang)!;
const otherDict = getDict(other);
---
<a
  class="locale-switch btn-ghost"
  href={localePath(other, path)}
  hreflang={other}
  lang={other}
  dir={other === 'ar' ? 'rtl' : 'ltr'}
  aria-label={`${t.a11y.languageSwitcher}: ${otherDict.meta.nameNative}`}
  data-locale-switch={other}
>
  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
    <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18" />
  </svg>
  <span>{otherDict.meta.nameNative}</span>
</a>
<style>
  .locale-switch {
    display: inline-flex; align-items: center; gap: var(--space-2);
    min-block-size: 40px; padding-inline: var(--space-3);
    border-radius: var(--r-pill); color: var(--c-muted);
    font-size: var(--fs-small); font-weight: var(--fw-bold);
    transition: color .16s var(--ease), background-color .16s var(--ease);
  }
  .locale-switch:hover { color: var(--c-paper); background: rgb(245 247 250 / .06); }
</style>
