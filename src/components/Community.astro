---
import { getDict, fill, type Locale } from '../i18n';
import { communityLines, overallRating } from '../data/testimonials';
import { localePath } from '../lib/url';
import SectionHead from './SectionHead.astro';

/** Nine of twelve industry sites ship a community or UGC wall — the single most
    adopted device in the set after numeric stats. Ours keeps the product tag on
    every line, so it stays proof rather than decoration. */
interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = getDict(lang);
const lines = communityLines(lang);
const rating = overallRating(lang);
// Two rows drifting in opposite directions, each duplicated so the loop is seamless.
const rowA = lines.slice(0, Math.ceil(lines.length / 2));
const rowB = lines.slice(Math.ceil(lines.length / 2));
const label = (product: string) =>
  product === 'membership' ? localePath(lang, 'membership') : localePath(lang, `programs/${product}`);
---
<SectionHead eyebrow={t.community.eyebrow} title={t.community.title} body={t.community.body} />

<p class="stat">
  <bdi class="value">{rating.value.toFixed(2)}</bdi>
  <span class="label">{fill(t.community.stat, { n: rating.count }, lang)}</span>
</p>

<div class="wall" aria-label={t.community.title}>
  {[rowA, rowB].map((row, r) => (
    <div class="track" data-dir={r === 0 ? 'a' : 'b'}>
      <ul class="strip">
        {[...row, ...row].map((entry, i) => (
          <li class="chip">
            <a href={label(entry.product)} tabindex={i < row.length ? 0 : -1} aria-hidden={i >= row.length ? 'true' : undefined}>
              <span class="quote">{entry.short}</span>
              <span class="who">{entry.name} · {entry.location}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>

<style>
  .stat { display: flex; align-items: baseline; gap: var(--space-4); margin-block-end: var(--space-8); flex-wrap: wrap; }
  .value { font-size: var(--fs-h2); font-weight: var(--fw-bold); color: var(--c-accent); font-variant-numeric: tabular-nums; }
  .label { font-size: var(--fs-body); color: var(--c-muted); }

  .wall { display: flex; flex-direction: column; gap: var(--space-4); overflow: hidden; }
  .track { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .strip { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--space-4); inline-size: max-content; }
  .track[data-dir='a'] .strip { animation: drift 68s linear infinite; }
  .track[data-dir='b'] .strip { animation: drift 84s linear infinite reverse; }
  .track:hover .strip, .track:focus-within .strip { animation-play-state: paused; }
  @keyframes drift { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  /* Direction-agnostic: the strip is laid out by flex, so RTL mirrors it for free. */

  .chip { flex: none; inline-size: min(360px, 78vw); }
  .chip a {
    display: flex; flex-direction: column; gap: var(--space-3);
    block-size: 100%; padding: var(--space-5, 1.25rem) var(--space-6);
    background: var(--c-surface); border: 1px solid var(--c-line); border-radius: var(--r-card);
  }
  .chip a:hover { border-color: var(--c-accent); }
  .quote { font-size: var(--fs-body); line-height: 1.55; color: var(--c-paper); }
  .who { font-size: var(--fs-eyebrow); color: var(--c-faint); margin-block-start: auto; }

  @media (prefers-reduced-motion: reduce) {
    .track { -webkit-mask-image: none; mask-image: none; overflow-x: auto; }
    .strip { animation: none !important; }
  }
</style>
