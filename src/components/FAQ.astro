---
interface Props { items: readonly { readonly q: string; readonly a: string }[]; }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((item) => (
    <details class="faq-item" name="faq">
      <summary>
        <span class="q">{item.q}</span>
        <span class="chev" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
        </span>
      </summary>
      <div class="a"><p>{item.a}</p></div>
    </details>
  ))}
</div>
<style>
  .faq { border-block-start: 1px solid var(--c-line); }
  .faq-item { border-block-end: 1px solid var(--c-line); }
  summary {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-4);
    padding-block: var(--space-6); cursor: pointer; list-style: none;
    font-weight: var(--fw-bold); font-size: var(--fs-lead); line-height: 1.4;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover .q { color: var(--c-accent); }
  .chev { flex: none; color: var(--c-muted); transition: transform .2s var(--ease); }
  details[open] .chev { transform: rotate(180deg); }
  .a { padding-block-end: var(--space-6); max-inline-size: var(--measure-prose); }
  .a p { color: var(--c-muted); line-height: 1.7; }
</style>
