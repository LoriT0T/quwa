---
import { getDict, fill, type Locale } from '../i18n';
import { ORDER_BUMP } from '../config/pricing';
import { price } from '../lib/currency';
interface Props { lang: Locale; title: string; }
const { lang, title } = Astro.props;
const t = getDict(lang);
---
<div class="bump" data-order-bump data-product={ORDER_BUMP.productId} data-cents={ORDER_BUMP.amount} data-title={title}>
  <label class="row">
    <input type="checkbox" data-bump-toggle />
    <span class="box" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 13 4 4L19 7" /></svg>
    </span>
    <span class="copy">
      <span class="h">{t.cart.bumpTitle}</span>
      <span class="b">{t.cart.bumpBody}</span>
      <span class="p">
        {fill(t.cart.bumpAdd, { amount: price(ORDER_BUMP.amount, 'USD', lang) })}
        <s class="was">{fill(t.cart.bumpSave, { amount: price(ORDER_BUMP.regularAmount, 'USD', lang) })}</s>
      </span>
    </span>
  </label>
</div>
<style>
  .bump {
    border: 2px dashed var(--c-accent); border-radius: var(--r-card);
    background: var(--c-accent-soft); padding: var(--space-4);
  }
  .row { display: flex; gap: var(--space-3); cursor: pointer; align-items: flex-start; }
  .row input { position: absolute; opacity: 0; inline-size: 1px; block-size: 1px; }
  .box {
    flex: none; inline-size: 24px; block-size: 24px; margin-block-start: 2px;
    border: 2px solid var(--c-accent); border-radius: var(--r-sm);
    display: grid; place-items: center; color: transparent; background: transparent;
  }
  .row input:checked + .box { background: var(--c-accent); color: var(--c-accent-ink); }
  .row input:focus-visible + .box { outline: 3px solid var(--c-accent); outline-offset: 2px; }
  .copy { display: flex; flex-direction: column; gap: var(--space-1); }
  .h { font-weight: var(--fw-bold); font-size: var(--fs-body); }
  .b { font-size: var(--fs-small); color: var(--c-muted); line-height: 1.55; }
  .p { font-size: var(--fs-small); font-weight: var(--fw-bold); color: var(--c-accent); margin-block-start: var(--space-1); }
  .was { color: var(--c-faint); font-weight: 400; margin-inline-start: var(--space-2); }
</style>
