---
import { getDict, type Locale } from '../i18n';
/**
 * The press-logo bar, taken from Hevy (320px, 2 words, 12 logos immediately under
 * the hero — the cheapest trust block in the industry set) and adapted.
 * We have no press, and inventing logos would be a false claim, so the same shape
 * carries the methodology the programs are actually built on.
 * See docs/ASSET-INVENTORY.md #1.
 */
interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = getDict(lang);
---
<section class="found" aria-label={t.foundations.eyebrow}>
  <div class="container-page">
    <p class="eyebrow">{t.foundations.eyebrow}</p>
    <ul class="row">
      {t.foundations.items.map((item) => (
        <li class="item">
          <span class="name">{item.name}</span>
          <span class="detail">{item.detail}</span>
        </li>
      ))}
    </ul>
    <p class="note">{t.foundations.note}</p>
  </div>
</section>
<style>
  .found {
    padding-block: var(--space-12);
    border-block: 1px solid var(--c-line);
    background: var(--c-surface);
  }
  .row {
    list-style: none; margin: var(--space-6) 0 0; padding: 0;
    display: grid; gap: var(--space-6) var(--space-8);
  }
  .item {
    display: flex; flex-direction: column; gap: var(--space-1);
    padding-inline-start: var(--space-4);
    border-inline-start: 2px solid var(--c-line-strong);
  }
  .name { font-size: var(--fs-body); font-weight: var(--fw-bold); line-height: 1.3; }
  .detail { font-size: var(--fs-small); color: var(--c-muted); line-height: 1.45; }
  .note {
    margin-block-start: var(--space-8); font-size: var(--fs-small);
    color: var(--c-faint); line-height: 1.6; max-inline-size: var(--measure-prose);
  }
  @media (min-width: 560px) { .row { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .row { grid-template-columns: repeat(3, 1fr); } }
</style>
