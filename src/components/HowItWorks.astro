---
import { getDict, type Locale } from '../i18n';
import { formatNumber } from '../lib/currency';
import SectionHead from './SectionHead.astro';
/** Juggernaut, Whoop and Caliber all ship a numbered "how it works" band.
    Ours is four steps and says you can stop after the first. */
interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = getDict(lang);
---
<SectionHead eyebrow={t.howItWorks.eyebrow} title={t.howItWorks.title} body={t.howItWorks.body} />
<ol class="steps">
  {t.howItWorks.steps.map((step, i) => (
    <li class="step">
      <span class="n" aria-hidden="true">{formatNumber(i + 1, lang, { minimumIntegerDigits: 2 })}</span>
      <div class="body">
        <h3 class="t">{step.title}</h3>
        <p class="b">{step.body}</p>
      </div>
    </li>
  ))}
</ol>
<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-8); counter-reset: step; }
  .step { display: flex; gap: var(--space-4); align-items: flex-start; }
  .n {
    flex: none; inline-size: 44px; block-size: 44px; display: grid; place-items: center;
    border: 1px solid var(--c-accent); border-radius: var(--r-pill);
    color: var(--c-accent); font-weight: var(--fw-bold); font-size: var(--fs-small);
    font-variant-numeric: tabular-nums;
  }
  .body { display: flex; flex-direction: column; gap: var(--space-2); }
  .t { font-size: var(--fs-card-title); }
  .b { font-size: var(--fs-body); color: var(--c-muted); line-height: 1.6; }
  @media (min-width: 768px) { .steps { grid-template-columns: 1fr 1fr; gap: var(--space-12) var(--space-8); } }
  @media (min-width: 1024px) { .steps { grid-template-columns: repeat(4, 1fr); } .step { flex-direction: column; } }
</style>
