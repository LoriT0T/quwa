---
import { getDict, type Locale } from '../i18n';
import { localePath } from '../lib/url';
import { getPrograms } from '../lib/content';
import { PRODUCT_PRICES } from '../config/pricing';
import { price } from '../lib/currency';
import SectionHead from './SectionHead.astro';

/**
 * Athlean-X runs `TAKE THE QUIZ` three times on its home page; joinladder's primary
 * CTA is `FIND YOUR PLAN` rather than "Buy". Both route the visitor instead of
 * asking them to choose from a grid.
 *
 * This one filters the real catalogue on the same `level` / `goal` / `equipment` /
 * `daysPerWeek` frontmatter the program pages print, so the recommendation cannot
 * drift from the products. It collects no email — the point is to be useful before
 * asking for anything.
 */
interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = getDict(lang);
const programs = await getPrograms(lang);

const catalogue = programs
  .filter((p) => p.data.kind === 'program')
  .map((p) => ({
    id: p.data.product,
    title: p.data.title,
    line: p.data.cardLine,
    level: p.data.level,
    goal: p.data.goal,
    equipment: p.data.equipment,
    days: p.data.daysPerWeek ?? 4,
    href: localePath(lang, `programs/${p.data.product}`),
    price: price(PRODUCT_PRICES[p.data.product] ?? 0, 'USD', lang),
    cents: PRODUCT_PRICES[p.data.product] ?? 0,
  }));

const questions = [
  { id: 'level', label: t.planFinder.questions.level, options: [
      { value: 'beginner', label: t.fields.trainingAges.beginner },
      { value: 'intermediate', label: t.fields.trainingAges.intermediate },
      { value: 'advanced', label: t.fields.trainingAges.advanced },
  ] },
  { id: 'goal', label: t.planFinder.questions.goal, options: [
      { value: 'muscle', label: t.fields.goals.gain },
      { value: 'strength', label: t.fields.goals.strength },
      { value: 'recomposition', label: t.fields.goals.cut },
  ] },
  { id: 'equipment', label: t.planFinder.questions.equipment, options: [
      { value: 'full-gym', label: t.planFinder.equipmentOptions['full-gym'] },
      { value: 'home-rack', label: t.planFinder.equipmentOptions['home-rack'] },
      { value: 'minimal', label: t.planFinder.equipmentOptions.minimal },
  ] },
  { id: 'days', label: t.planFinder.questions.days, options: [
      { value: '3', label: t.planFinder.dayOptions['3'] },
      { value: '4', label: t.planFinder.dayOptions['4'] },
      { value: '5', label: t.planFinder.dayOptions['5'] },
      { value: '6', label: t.planFinder.dayOptions['6'] },
  ] },
];

const clientCopy = {
  resultTitle: t.planFinder.resultTitle,
  resultNone: t.planFinder.resultNone,
  resultWhy: t.planFinder.resultWhy,
  alsoFits: t.planFinder.alsoFits,
  viewProgram: t.cta.viewProgram,
  progress: t.planFinder.progress,
  level: t.common.level,
  goal: t.common.goal,
  equipment: t.common.equipment,
  daysPerWeek: t.common.daysPerWeek,
  reasons: {
    level: t.common.level,
    goal: t.common.goal,
    equipment: t.common.equipment,
    days: t.common.format,
  },
};
---
<SectionHead eyebrow={t.planFinder.eyebrow} title={t.planFinder.title} body={t.planFinder.body} />

<div class="finder card" data-plan-finder>
  <script is:inline type="application/json" data-finder-catalogue set:html={JSON.stringify(catalogue)}></script>
  <script is:inline type="application/json" data-finder-copy set:html={JSON.stringify(clientCopy)}></script>

  <div class="quiz" data-finder-quiz>
    <p class="progress" data-finder-progress></p>
    <div class="bar" aria-hidden="true"><span data-finder-bar></span></div>

    {questions.map((q, i) => (
      <fieldset class="q" data-question={q.id} data-index={i} hidden={i > 0}>
        <legend class="q-label">{q.label}</legend>
        <div class="opts">
          {q.options.map((o) => (
            <button class="opt" type="button" data-answer={o.value}>{o.label}</button>
          ))}
        </div>
      </fieldset>
    ))}
  </div>

  <output class="result" data-finder-result hidden></output>

  <button class="btn btn-ghost restart" type="button" data-finder-restart hidden>{t.planFinder.restart}</button>
</div>

<script>
  import '../scripts/plan-finder';
</script>

<style>
  .finder { padding: var(--space-8); max-inline-size: 860px; }
  .progress {
    font-size: var(--fs-eyebrow); font-weight: var(--fw-bold); color: var(--c-faint);
    letter-spacing: var(--tracking-eyebrow); text-transform: uppercase;
  }
  :global(:root[lang="ar"]) .progress { text-transform: none; }
  .bar {
    block-size: 3px; background: var(--c-line); border-radius: var(--r-pill);
    margin-block: var(--space-3) var(--space-8); overflow: hidden;
  }
  .bar > span {
    display: block; block-size: 100%; inline-size: 25%;
    background: var(--c-accent); transition: inline-size .28s var(--ease);
  }
  .q { border: none; margin: 0; padding: 0; }
  .q-label {
    font-size: var(--fs-h3); font-weight: var(--fw-bold); line-height: 1.3;
    padding: 0; margin-block-end: var(--space-6); max-inline-size: 24ch;
  }
  .opts { display: grid; gap: var(--space-3); }
  .opt {
    min-block-size: 56px; padding: var(--space-3) var(--space-6);
    background: transparent; color: var(--c-paper); text-align: start;
    border: 1px solid var(--c-line-strong); border-radius: var(--r-control);
    font-size: var(--fs-body); font-weight: var(--fw-bold); cursor: pointer;
    transition: border-color .16s var(--ease), background-color .16s var(--ease), transform .16s var(--ease);
  }
  .opt:hover { border-color: var(--c-accent); background: var(--c-accent-soft); transform: translateY(-1px); }
  .restart { margin-block-start: var(--space-6); }
  @media (min-width: 560px) { .opts { grid-template-columns: 1fr 1fr; } }
</style>
