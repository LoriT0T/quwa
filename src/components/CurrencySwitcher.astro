---
import { getDict, type Locale } from '../i18n';
import { CURRENCY_CODES } from '../config/pricing';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = getDict(lang);
---
<label class="cur">
  <span class="sr-only">{t.a11y.currencySwitcher}</span>
  <select data-currency-select aria-label={t.a11y.currencySwitcher}>
    {CURRENCY_CODES.map((code) => <option value={code}>{code}</option>)}
  </select>
</label>
<style>
  .cur { display: inline-flex; align-items: center; }
  .cur select {
    min-block-size: 40px; padding-inline: var(--space-3);
    background: transparent; color: var(--c-muted);
    border: 1px solid var(--c-line); border-radius: var(--r-pill);
    font-size: var(--fs-small); font-weight: var(--fw-bold);
    font-family: inherit; cursor: pointer;
  }
  .cur select:hover { color: var(--c-paper); border-color: var(--c-line-strong); }
  .cur option { background: var(--c-surface); color: var(--c-paper); }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }
</style>
