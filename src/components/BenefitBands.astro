---
import { getDict, type Locale } from '../i18n';
/** Whoop runs seven consecutive 519px benefit bands, one idea each, 3–8 words per
    band; rpstrength runs four at 500px. Two independent references converge on a
    ~500px repeating unit, so ours is four bands on that rhythm. */
interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = getDict(lang);
---
<ul class="bands">
  {t.bands.items.map((item, i) => (
    <li class="band">
      <div class="container-page inner">
        <p class="eyebrow">{item.eyebrow}</p>
        <h3 class="h2 t">{item.title}</h3>
        <p class="b">{item.body}</p>
        <span class="rule" aria-hidden="true" style={`--i:${i}`}></span>
      </div>
    </li>
  ))}
</ul>
<style>
  .bands { list-style: none; margin: 0; padding: 0; }
  .band {
    display: flex; align-items: center;
    min-block-size: clamp(320px, 46vw, 500px);
    border-block-end: 1px solid var(--c-line);
  }
  .band:nth-child(even) { background: var(--c-surface); }
  .band:last-child { border-block-end: none; }
  .inner {
    display: flex; flex-direction: column; gap: var(--space-4);
    position: relative; padding-block: var(--space-12);
  }
  .t { max-inline-size: 18ch; }
  .b { font-size: var(--fs-lead); color: var(--c-muted); line-height: 1.6; max-inline-size: var(--measure-prose); }
  .rule {
    position: absolute; inset-block-start: 0; inset-inline-start: var(--page-x);
    inline-size: 48px; block-size: 3px; border-radius: var(--r-pill);
    background: var(--c-accent); opacity: calc(1 - var(--i) * 0.2);
  }
</style>
